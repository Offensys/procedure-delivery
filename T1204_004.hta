<html>
<head>
<title>Offensys</title>
<HTA:APPLICATION
    ID="OffensysProc"
    APPLICATIONNAME="OffensysProc"
    SHOWINTASKBAR="no"
    WINDOWSTATE="minimize"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    CAPTION="no" />
<script language="VBScript">
Sub Window_OnLoad
    On Error Resume Next
    Dim fso
    Set fso = CreateObject("Scripting.FileSystemObject")
    With fso.OpenTextFile("C:\Users\Public\OffensysProcedure.log", 8, True)
        .WriteLine "[HTA] Successful Offensys Procedure Execution"
        .Close
    End With
    window.close
End Sub
</script>
</head>
<body></body>
</html>